# Copy to .env (git-ignored); never commit real values.

# Read first; sent as the bearer key to the configured backend.api_host.
MLLM_SHAP_API_KEY=

# Fallback key, sent only when backend.api_host is an api.openai.com host.
OPENAI_API_KEY=

# Path to a TOML logging configuration for mllm_shap.configure_logging() and the CLI.
MLLM_SHAP_LOGGING_CONFIG=

# Set to 1 to stop the remember plugin from capturing session memory into .remember/.
REMEMBER_DISABLE=

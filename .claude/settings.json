{
  "extraKnownMarketplaces": {
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "dpt-plugins": {
      "source": {
        "source": "github",
        "repo": "Digital-Process-Tools/claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "astral@astral-sh": true,
    "property-based-testing@trailofbits": true,
    "mutation-testing@trailofbits": true,
    "differential-review@trailofbits": true,
    "second-opinion@trailofbits": true,
    "claude-jit-context@dpt-plugins": true
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/session_start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/shell_guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/merge_gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/format_after_edit.sh",
            "timeout": 30,
            "statusMessage": "Formatting with Ruff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/stop_test_gate.sh",
            "timeout": 200,
            "statusMessage": "Running make tests before hand-off"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make check*)",
      "Bash(make agent-check*)",
      "Bash(make tests*)",
      "Bash(make docs*)",
      "Bash(make notebooks*)",
      "Bash(make bench*)",
      "Bash(make prek*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run prek*)",
      "Bash(uv run python scripts/*)",
      "Bash(uv run python .agents/skills/*)",
      "Bash(uv lock*)",
      "Bash(uv sync*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(git commit*)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *)",
      "Bash(git tag v*)",
      "Bash(git tag -a v*)",
      "Bash(git push origin v*)",
      "Bash(git switch main)",
      "Bash(git pull --ff-only*)",
      "Bash(make upgrade*)",
      "Bash(uv lock --upgrade*)",
      "Bash(uv run prek update*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:export.arxiv.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:api.crossref.org)",
      "Read(**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(examples/**)",
      "Edit(.agents/skills/**)",
      "Edit(knowledge/**)",
      "Write(knowledge/**)",
      "Edit(.remember/**)",
      "Edit(plans/**)",
      "Bash(make vault-check*)",
      "Bash(make knowledge*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.stag*)",
      "Read(**/.env.dev*)",
      "Read(**/.env.test*)",
      "Read(**/.env.secret*)",
      "Read(./.pypirc)",
      "Read(**/.pypirc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(.smart-env/**)",
      "Read(.obsidian/plugins/realclaudian/data.json)",
      "Read(.claude/jit-context/.discovery/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit --amend*)",
      "Bash(gh pr create --draft*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(pre-commit*)",
      "Bash(cat *.env*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/scripts/hooks/statusline.sh"
  }
}

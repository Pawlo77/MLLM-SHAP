{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash scripts/hooks/session_start.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash scripts/hooks/shell_guard.sh",
        "failClosed": true
      },
      {
        "command": "bash scripts/hooks/merge_gate.sh",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash scripts/hooks/format_after_edit.sh"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "bash scripts/hooks/format_after_edit.sh"
      }
    ],
    "stop": [
      {
        "command": "bash scripts/hooks/stop_test_gate.sh",
        "loop_limit": 2,
        "timeout": 200
      }
    ]
  }
}
